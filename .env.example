# Copy this file to .env and fill in your key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional settings
# PORT=8000
# HOST=127.0.0.1            # keep 127.0.0.1 so only your machine can use your key
# Models pre-selected the first time you open the app (comma separated OpenRouter ids)
# DEFAULT_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-6.1-sol,google/gemini-4-argon,deepseek/deepseek-v4.1-flash,mistralai/mistral-large-4-0
# REQUEST_TIMEOUT=300       # seconds per answer
